{
  "name": "@andrewcyuan/focusgrid",
  "version": "0.3.0",
  "description": "Keyboard-native pane layouts and deterministic focus management for web applications.",
  "keywords": [
    "focus-management",
    "keyboard-navigation",
    "pane-layout",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewcyuan/focusgrid.git",
    "directory": "packages/focusgrid"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/react/styles.css",
    "./react/styles.css"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js",
      "require": "./dist/dom/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./react/styles.css": "./dist/react/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown core/src/index.ts --config buildConfig.mjs --format esm,cjs --out-dir dist/core && tsdown dom/src/index.ts --config buildConfig.mjs --format esm,cjs --out-dir dist/dom --no-clean && tsdown react/src/index.tsx --config buildConfig.mjs --format esm,cjs --out-dir dist/react --no-clean && cp react/src/styles.css dist/react/styles.css",
    "test": "vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@andrewcyuan/shortcut-engine": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
