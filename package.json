{
  "name": "focusgrid",
  "version": "0.0.1",
  "private": true,
  "description": "Keyboard-native pane layouts, deterministic focus management, and shortcut routing for the web.",
  "keywords": [
    "keyboard-navigation",
    "focus-management",
    "pane-layout",
    "react",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewcyuan/focusgrid.git"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --workspaces build",
    "test": "node --test test/release.test.mjs && bun run --workspaces test",
    "typecheck": "bun run --workspaces typecheck",
    "lint": "bun run --workspaces --if-present lint",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "bun scripts/release.mjs",
    "release:dry-run": "bun scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "tsdown": "^0.22.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unrun": "^0.3.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "tsc": "^2.0.4"
  }
}
