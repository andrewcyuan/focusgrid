{
  "name": "focusgrid",
  "version": "0.0.1",
  "private": true,
  "description": "Keyboard-native pane layouts, deterministic focus management, and shortcut routing for the web.",
  "keywords": [
    "focus-management",
    "keyboard-navigation",
    "pane-layout",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewcyuan/focusgrid.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --workspaces build",
    "test": "bun run --workspaces --if-present test",
    "typecheck": "bun run --workspaces typecheck",
    "lint": "oxlint && bun run --workspaces typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "bun scripts/release.mjs",
    "release:dry-run": "bun scripts/release.mjs --dry-run",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.3.14"
}
