#!/usr/bin/env bash
set -euo pipefail

PNPM_VERSION="10.25.0"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PNPM_CLI="$ROOT_DIR/.corepack/cache/v1/pnpm/$PNPM_VERSION/bin/pnpm.cjs"
export COREPACK_HOME="${COREPACK_HOME:-$ROOT_DIR/.corepack/cache}"
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0

if [[ -f "$PNPM_CLI" ]]; then
  exec node "$PNPM_CLI" "$@"
fi

if command -v pnpm >/dev/null 2>&1; then
  actual_version="$(pnpm --version)"
  if [[ "$actual_version" == "$PNPM_VERSION" ]]; then
    exec pnpm "$@"
  fi
fi

if command -v corepack >/dev/null 2>&1; then
  actual_version="$(corepack pnpm --version)"
  if [[ "$actual_version" != "$PNPM_VERSION" ]]; then
    echo "Expected pnpm $PNPM_VERSION, but Corepack resolved pnpm $actual_version." >&2
    exit 1
  fi

  exec corepack pnpm "$@"
fi

cat >&2 <<EOF
pnpm $PNPM_VERSION is required for this repo.

Install that exact version globally, or install Corepack and run this command
again with network access so Corepack can populate the ignored repo-local cache.
EOF
exit 1
