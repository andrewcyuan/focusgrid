{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@andrewcyuan/shortcut-engine": [
        "./packages/shortcut-engine/src/index.ts"
      ],
      "@andrewcyuan/focusgrid/core": [
        "./packages/focusgrid/core/src/index.ts"
      ],
      "@andrewcyuan/focusgrid/dom": [
        "./packages/focusgrid/dom/src/index.ts"
      ],
      "@andrewcyuan/focusgrid/react": [
        "./packages/focusgrid/react/src/index.tsx"
      ],
      "@andrewcyuan/shortcut-engine/react": [
        "./packages/shortcut-engine/src/react/index.ts"
      ]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true
  }
}
